# rw-tasks-codecollection: the rw-task capability image.
#
# Image == capability, 1:1 (runwhen_capability/loader.py's
# discover_capability_dir docstring) -- but rw-task is not a capability with
# tasks of its own. It is the generic runtime every custom capability
# compiles onto: what actually runs at request time (a workspace author's
# own `capability.yaml` and task files) rides inside the request as a small,
# content-hashed bundle, not inside this image. See
# capabilities/rw-task/README.md for that flow end to end.
#
# It ships:
#   - the runwhen_capability SDK and its rwtask task host, which loads and
#     runs a request's bundle -- the release pyproject.toml pins;
#   - bash, kubectl, jq, yq, curl, the PostgreSQL client (psql) and
#     redis-cli -- the interpreters and CLIs a bundle's own bash/Python
#     tasks may invoke;
#   - capabilities/rw-task/ itself: a manifest with no tasks (see its
#     header comment) and a tasks.py that registers none.
#
# Every tool is pinned AND verified, by one of three mechanisms:
#
#   apt      -> scripts/apt-packages.txt (name=version, one per line);
#     scanners read the dpkg database directly, so no separate SBOM entry
#     is needed for these.
#   GitHub release binaries (kubectl, yq -- Debian's own `yq` package is an
#     unrelated Python/jq wrapper, not this one) -> sbom/tools.cdx.json
#     (CycloneDX 1.6), installed by scripts/install_tools.sh, which
#     verifies each download's sha256 against the SBOM. A statically linked
#     binary in /usr/local/bin is INVISIBLE to any scanner that reads a
#     package database, so the SBOM's PURL per component is what makes
#     these two CVE-matchable at all.
#   runwhen-capability (the SDK) -- pinned to a release tag, here and in
#     pyproject.toml. pip's --require-hashes mode does not support VCS
#     requirements at all, so this is installed in its OWN,
#     non-hash-checked `pip install` step, same as every other capability
#     image in this organisation installs its SDK layer. Everything IT pulls
#     in transitively (attrs, pydantic, PyYAML, ...) is pinned by
#     constraints.txt instead -- see that file's header and the `pip
#     install` step below.
#
# Base image pinned by digest -- `python:3.12-slim`, resolved with
# `docker buildx imagetools inspect python:3.12-slim` on 2026-09-28. This is
# the multi-arch INDEX digest (covers both linux/amd64 and linux/arm64,
# which is what CI's build matrix builds), not a single-platform manifest
# digest. Re-resolve and bump when the base needs an update.
ARG BASE_IMAGE=python:3.12-slim@sha256:f77ac9e44ae96ef2c90b8053ea08c31f8be030f824196b0ae4db6d462c84e51f

# ---------------------------------------------------------------------------
# builder -- only used to `pip install` the SDK from its pinned git tag,
# which needs `git` on PATH. rw-task's own tasks never shell out to git (a
# bundle's tasks might invoke it, but only if a workspace author's own task
# file does -- and this image doesn't ship it, so it can't), so `git` never
# reaches the final image: one less binary a bundle's task code could reach
# for. An isolated venv, not the base image's system site-packages: the
# final stage copies this directory verbatim and nothing else, so what's
# installed here is exactly (and only) what ships.
# ---------------------------------------------------------------------------
FROM ${BASE_IMAGE} AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# git is pinned here, not in scripts/apt-packages.txt: that file is also
# read by the final stage's own `apt-get install` (every non-comment line,
# verbatim) and by scripts/gen_toolbox_label.py for the toolbox label --
# both of which must NOT list git (it never reaches the final image; see
# this file's header comment). ca-certificates is a genuine final-image
# tool too, so it stays sourced from apt-packages.txt, shared with the
# final stage's own install below.
ARG GIT_VERSION=1:2.47.3-0+deb13u1
COPY scripts/apt-packages.txt /build/apt-packages.txt
RUN apt-get update \
    && apt-get install -y --no-install-recommends "git=${GIT_VERSION}" \
       $(grep -E '^ca-certificates=' /build/apt-packages.txt) \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"

# The SDK, at the release pyproject.toml pins -- see the header comment
# above for why this is a separate, non-hash-checked install step. Nothing
# of this project's own is copied in: it has no importable package (see
# pyproject.toml's `[tool.setuptools] packages = []`), so installing it
# here would add nothing this stage doesn't already have.
#
# constraints.txt pins every transitive dependency this pulls in (attrs,
# pydantic, PyYAML, ...) to an exact version, resolved for this same base
# image (see that file's own header). Without it, pip's resolver is free to
# pick whatever the newest compatible release of each is AT BUILD TIME --
# fine for the image itself, but it made the checked-in
# com.runwhen.rw-task.toolbox label below drift out from under CI, since
# `make toolbox-label-check` and this build would each resolve
# independently and land on different versions.
WORKDIR /app
COPY pyproject.toml README.md LICENSE constraints.txt /app/
RUN pip install --no-cache-dir -c constraints.txt /app

# ---------------------------------------------------------------------------
# final -- the shipped image. No git, no C toolchain, no build-time apt
# state beyond what's declared as a genuine runtime tool below.
# ---------------------------------------------------------------------------
FROM ${BASE_IMAGE} AS final
ARG TARGETARCH

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# bash, ca-certificates, curl, jq, postgresql-client (psql), redis-tools
# (redis-cli) -- every runtime tool this image promises except kubectl and
# yq (below). `bash` is pinned and reinstalled explicitly even though the
# base image already ships a bash, so its exact version is recorded the
# same way as everything else here (see scripts/apt-packages.txt's header).
# `curl` and `jq` double as build-time tools for the kubectl/yq install
# step right below -- there is no separate builder stage for them because
# they ship at runtime anyway.
COPY scripts/apt-packages.txt /build/apt-packages.txt
RUN apt-get update \
    && grep -v '^#' /build/apt-packages.txt | grep -v '^$' | xargs apt-get install -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

# kubectl + yq, sha256-verified per architecture against the SBOM.
# Installing from the SBOM rather than from tools/tools.yaml is deliberate:
# a version bumped in tools.yaml but not re-hashed by
# scripts/gen_tool_sbom.py still carries the old URL and hash here, so it
# cannot reach an image.
COPY sbom/tools.cdx.json /build/sbom/tools.cdx.json
COPY scripts/install_tools.sh /build/scripts/install_tools.sh
RUN TARGETARCH="${TARGETARCH}" SBOM=/build/sbom/tools.cdx.json \
      sh /build/scripts/install_tools.sh \
    && rm -rf /build

COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"

# --- OCI image annotations (opencontainers.org/image-spec) -------------------
# Standard keys registries and scanners read: `source` and `revision` are what
# let a scan result be traced back to the commit that produced the image, and
# what an SBOM consumer uses to correlate this image with sbom/tools.cdx.json.
# REVISION/CREATED are build args because they are the only two values that
# cannot be known from the source tree alone; CI passes them.
ARG REVISION=unknown
ARG CREATED=unknown
LABEL org.opencontainers.image.title="rw-task" \
      org.opencontainers.image.description="Generic runtime image for custom capabilities on the RunWhen platform" \
      org.opencontainers.image.source="https://github.com/runwhen-contrib/rw-tasks-codecollection" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.created="${CREATED}" \
      io.runwhen.capability="rw-task" \
      io.runwhen.sbom="/usr/share/rw-task/tools.cdx.json"

# Keep the tool SBOM IN the image, not only in the repo -- a registry scanner
# handed the image alone otherwise has no way to learn about the two
# statically linked binaries in /usr/local/bin; they have no dpkg record.
COPY sbom/tools.cdx.json /usr/share/rw-task/tools.cdx.json

# Base64 of capabilities/rw-task/manifest.yaml, produced at build time by
# `rwtask label capabilities/rw-task`. This is how the catalog discovers this
# capability's manifest without a platform release: it reads the label off
# the pushed image, never a repo checkout.
ARG CAPABILITY_MANIFEST_B64=""
LABEL com.runwhen.capability.manifest.v1="${CAPABILITY_MANIFEST_B64}"

# rw-task ships no schemas/ (it has no task outputs of its own -- see
# capabilities/rw-task/README.md), so this is always empty. Declared anyway
# for parity with every other capability image, so a catalog reader can
# depend on the label always being present.
ARG CAPABILITY_SCHEMAS_B64=""
LABEL com.runwhen.capability.schemas.v1="${CAPABILITY_SCHEMAS_B64}"

# A JSON list of {"name", "version"} for every binary and Python library
# this image ships (apt packages, kubectl/yq, and everything `pip install`
# above pulled in), base64-encoded the same way as the two labels above.
# GENERATED -- do not hand-edit this line: `make toolbox-label` recomputes
# it from scripts/apt-packages.txt, tools/tools.yaml and a clean `pip
# install` of this project, and CI's `make toolbox-label-check` fails if it
# has drifted. It is computed ahead of `docker build` and checked in,
# rather than assembled inside this Dockerfile, because the reusable image
# workflow this repo's CI calls builds with a fixed set of build args (see
# .github/workflows/build-push.yaml) that has no slot for a fifth,
# image-specific one -- see scripts/gen_toolbox_label.py's header for the
# full reasoning.
LABEL com.runwhen.rw-task.toolbox=""
WORKDIR /app
COPY capabilities/rw-task /app/capabilities/rw-task

# Non-root by default, for a plain `docker run` -- but this image must not
# DEPEND on that uid owning anything: the runner's real executor pod spec
# (executor_pool.go's BuildExecutorPod) runs every executor container as uid
# 65532, an arbitrary uid this image never created, with a read-only root
# filesystem and only "/work" (a pool-provided emptyDir) mounted writable --
# no "/tmp" at all. So nothing below is chowned to `runwhen`: /app and
# /opt/venv keep the world-readable/executable permissions `COPY` and `pip
# install` already leave them at, which is all any uid needs to read and run
# them; the only path this image ever writes to at request time is "/work"
# itself, which the runner always mounts writable regardless of which uid
# the pod runs as (also: no ServiceAccount token automount, set in
# manifest.yaml's execution.serviceAccountToken, and a stateless pod so
# nothing here is expected to persist across requests).
#
# "/work" is also baked in here, mode 1777 (world-writable, sticky, like
# /tmp) -- not because any uid needs to own it, but so `rwtask serve`'s own
# --workdir default (/work) already exists and is writable under a plain
# `docker run` with no volume at all (no pod, no emptyDir): `mkdir("/work")`
# as a non-root uid otherwise fails on "/"'s own permissions, since nothing
# else creates "/work" at that point. The real pod spec always mounts its
# "work" emptyDir at this exact path, which shadows this baked-in directory
# entirely, so its contents/ownership here never matter there.
RUN useradd --create-home --uid 1000 --shell /usr/sbin/nologin runwhen \
    && mkdir -p /work \
    && chmod 1777 /work
USER runwhen

# TMPDIR points at a subdirectory of "/work" -- the runner's only writable
# mount, with no writable "/tmp" anywhere in the real pod spec -- so
# anything that falls back to the platform temp dir (a bundle task's own
# `mktemp`, some future stdlib/dependency tempfile.gettempdir() call) lands
# somewhere writable instead of failing on a read-only "/tmp". The bundle
# host's own per-request HOME/TMPDIR (bundle.py's `_prepare_scope`) is
# unaffected either way -- it always lives inside that request's own scope
# directory, never at this fixed path.
#
# The SDK does NOT create this directory itself: `serve()` only mkdir's
# --workdir itself (serve.py's `workdir.mkdir(parents=True, exist_ok=True)`),
# never a "tmp" child of it. Flagged to the SDK stream as a gap worth
# closing there; handled here instead, since editing the SDK is out of
# scope for this repo. "/work" starts empty on every pod (a fresh
# emptyDir), so this can't be done at image build time either -- it has to
# run at container start, by whatever uid the container actually runs as,
# which is why it's folded into CMD below instead of a build-time mkdir.
ENV TMPDIR=/work/tmp

# rwtask's argv IS the container command -- no Robot runtime, nothing to
# reset. ENTRYPOINT [] is kept explicit (rather than simply absent) so a
# `docker run <image> <anything>` still fully replaces the command, same as
# every other capability image in this organisation -- CMD only supplies
# the default.
#
# --capability-dir is baked in explicitly rather than left to
# discover_capability_dir's default, for the same reason every other
# capability image in this organisation does this: the image's own argv
# must never rely on "there happens to be exactly one
# capabilities/*/manifest.yaml" being true.
#
# --workdir /work matches the runner's real executor pod spec exactly (the
# pool's "work" emptyDir is always mounted at /work) -- also `rwtask
# serve`'s own CLI default, so a caller that overrides CMD without a
# --workdir of their own (the reusable capability-image workflow's built-in
# smoke test does this) still lands on the same path. --allow-bundles opts
# this image into running bundle requests -- a custom capability's code,
# carried inside the request -- since bundle mode is off by default in the
# SDK and only an image built to run them, like this one, should enable it.
#
# Run through `sh -c`, not a bare exec-form argv: TMPDIR points at a path
# nothing else creates (see above), so it has to be mkdir'd at container
# start, by whatever uid is actually running, before rwtask itself starts.
ENTRYPOINT []
CMD ["sh", "-c", "mkdir -p \"${TMPDIR:-/work/tmp}\" && exec rwtask serve --capability-dir /app/capabilities/rw-task --workdir /work --allow-bundles"]
